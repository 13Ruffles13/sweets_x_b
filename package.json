{
  "name": "sweets_x_b",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "audit": "npm audit",
    "build": "npm run format && npm run lint && npm run test && tsc -b && vite build && node -e \"console.log('\\n\\u001b[32m✅ BUILD SUCCESSFUL\\u001b[0m\\n')\" || node -e \"console.error('\\n\\u001b[31m❌ BUILD FAILED\\u001b[0m\\n')\"",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format --write .",
    "migrate": "biome migrate",
    "migrate:write": "biome migrate --write",
    "check": "npm run lint && npm run test",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "fresh-install": "powershell -Command \"Remove-Item -Recurse -Force node_modules; Remove-Item -Force package-lock.json; npm cache clean --force; npx npm-check-updates -u; npm install\"",
    "prepush": "npm run fresh-install && npm run build",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "cypress": "cypress open",
    "cypress:cli": "cypress run"
  },
  "dependencies": {
    "@types/node": "^26.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "undici-types": "^8.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "cypress": "^15.20.1",
    "cypress-axe": "^1.7.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "react-router-dom": "^7.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
