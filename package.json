{
  "name": "sweets_x_b",
  "description": "Sweets X B bakery website and ordering application",
  "homepage": "https://sweetsxb.netlify.app/",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@12.2.3",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "check": "npm run lint && npm run test && tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "coverage": "vitest run --coverage",
    "audit": "npm audit",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "cypress": "cypress open",
    "cypress:run": "cypress run",
    "migrate": "biome migrate",
    "migrate:write": "biome migrate --write",
    "clean": "npm ci",
    "update": "npx npm-check-updates -u && npm install"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "axe-core": "^4.14.1",
    "cypress": "15.0.0",
    "cypress-axe": "^1.7.0",
    "jsdom": "^31.0.1",
    "knip": "^6.48.0",
    "typescript": "^7.0.2",
    "undici-types": "^8.13.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
