{
  "name": "sweets_x_b",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "check": "npm run lint && npm run test && tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "coverage": "vitest run --coverage",
    "audit": "npm audit",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "cypress": "cypress open",
    "cypress:run": "cypress run",
    "migrate": "biome migrate",
    "migrate:write": "biome migrate --write",
    "fresh-install": "powershell -Command \"Remove-Item -Recurse -Force node_modules; npm ci\"",
    "update": "npx npm-check-updates -u && npm install"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.13.0",
    "cypress": "^15.20.1",
    "cypress-axe": "^1.7.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "typescript": "^7.0.2",
    "undici-types": "^8.10.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
