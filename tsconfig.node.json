/*
  Target Environment: Node runtime (tooling or config)

  Key Purposes:
  - Type-checks Node.js scripts and config files
  - Vite.config.ts or script files
  - Use modern ES module and bundler-compatible resolution

  Target API or Libraries:
  - Node.js APIs
  - fs, path, etc.
  - Cypress config
*/
{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2025",
    "lib": ["ES2025"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["vite.config.ts", "cypress.config.ts"]
}
